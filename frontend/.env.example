# Translation API Keys (Optional)
# Google Translate API - Get your key from: https://cloud.google.com/translate/docs/setup
REACT_APP_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# LibreTranslate API Key (Optional for public instance)
# Get your key from: https://libretranslate.com/
REACT_APP_LIBRETRANSLATE_API_KEY=your_libretranslate_api_key_here

# LibreTranslate Custom Instance URL (Optional)
REACT_APP_LIBRETRANSLATE_URL=https://libretranslate.de

# MyMemory API - No API key required for basic usage
# Premium features available at: https://mymemory.translated.net/ 

# X Integration — general demo corpus on by default (not a personal handle)
# REACT_APP_X_HANDLE=your_handle
# REACT_APP_X_OAUTH_URL=https://x.com/your_handle
# Set to "false" to require live X (needs X_BEARER_TOKEN on backend)
REACT_APP_USE_DEMO_X_CORPUS=true
REACT_APP_NIMBLE_MAX_CALLS=4

# Reddit Integration
REACT_APP_REDDIT_CONNECT_URL=https://www.reddit.com