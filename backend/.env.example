# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/yoree

# Blockchain Configuration
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_CHAIN_ID=97
PYUSD_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TBNB_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=your_private_key_here

# AI Configuration
AI_MODEL_ENDPOINT=http://localhost:8000/predict
AI_API_KEY=your_ai_api_key_here
AI_MAX_CONCURRENT_REQUESTS=10

# X API — Bearer Token from developer.x.com (never commit the real value)
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAG3F8QEAAAAAAcFF7Tq7HrSWxWNV9wLGZHGh%2Bsk%3DphoYt3NVFWNa844Cr4qnMrNnfLG9dDv6yDKoMBVMgdTot8EFoj

# Low-budget live graph (≈ 1 lookup + followers + following + N tweet calls; then cache)
# Typical demo refresh with defaults: ~6 API calls once per X_GRAPH_CACHE_SECONDS
X_GRAPH_MAX_FOLLOWERS=5
X_GRAPH_MAX_FOLLOWING=5
X_GRAPH_MAX_ACCOUNTS=5
X_GRAPH_TWEETS_PER_ACCOUNT=1
X_GRAPH_MAX_LINES=5
X_GRAPH_CACHE_SECONDS=3600

# Nimble Web Corroboration (keep server-side only)
NIMBLE_API_KEY=your_nimble_api_key_here
# Max Nimble Extract calls per pipeline run (DexScreener, CoinGecko, StockTwits rotation)
NIMBLE_MAX_CALLS_PER_RUN=4

# Environment
RUST_ENV=development
RUST_LOG=info

# Optional: For production deployments
# RUST_ENV=production
# RUST_LOG=warn 